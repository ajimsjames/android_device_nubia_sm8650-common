<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <Preference
        android:key="power_profile"
        android:icon="@drawable/ic_nubia"
        android:summary="@string/power_profiles_summary"
        android:title="@string/power_profiles_title">
        <intent android:action="org.lineageos.settings.POWER_PROFILE_SETTINGS" />
    </Preference>

    <Preference
        android:key="fan"
        android:icon="@drawable/ic_fan"
        android:summary="@string/fan_control_summary"
        android:title="@string/fan_control_title">
        <intent android:action="org.lineageos.settings.FAN_SETTINGS" />
    </Preference>

    <Preference
        android:key="trigger"
        android:icon="@drawable/ic_triggers"
        android:summary="@string/trigger_buttons_summary"
        android:title="@string/trigger_buttons_title">
        <intent android:action="org.lineageos.settings.TRIGGER_SETTINGS" />
    </Preference>
</PreferenceScreen>
