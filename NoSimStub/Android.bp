android_app {
    name: "NoSimStub",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
}
