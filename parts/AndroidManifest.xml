<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BATTERY_STATS" />
    <uses-permission android:name="android.permission.READ_FRAME_BUFFER" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/device_settings_app_name"
        android:persistent="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".power.ChargeBypassReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.lineageos.settings.power.ACTION_DISABLE_BYPASS" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".TileActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name=".nubia.NubiaActivity"
            android:label="@string/nubia_title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/nubia_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/nubia_summary" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_nubia" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-50" />
        </activity>

        <activity
            android:name=".fan.FanActivity"
            android:label="@string/fan_control_title"
            android:exported="true">
            <intent-filter>
                <action android:name="org.lineageos.settings.FAN_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".trigger.TriggerActivity"
            android:label="@string/trigger_buttons_title"
            android:exported="true">
            <intent-filter>
                <action android:name="org.lineageos.settings.TRIGGER_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".trigger.TriggerAppSelectorActivity"
            android:label="@string/trigger_select_apps_title"
            android:exported="true">
            <intent-filter>
                <action android:name="org.lineageos.settings.TRIGGER_SELECT_APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".optimizer.GameOptimizerActivity"
            android:label="@string/game_optimizer_title"
            android:exported="true">
            <intent-filter>
                <action android:name="org.lineageos.settings.GAME_OPTIMIZER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".slider.SliderDialogActivity"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.Alert"
            android:exported="false" />


        <!-- Services -->
        <service
            android:name=".fan.FanThermalService"
            android:exported="false" />

        <service
            android:name=".trigger.TriggerService"
            android:exported="false" />

        <service
            android:name=".trigger.TriggerOverlayService"
            android:exported="false" />

        <service
            android:name=".slider.SliderSwitchService"
            android:exported="false" />

        <service
            android:name=".slider.DiabloNotificationService"
            android:exported="false" />

        <!-- QS Tiles -->
        <service
            android:name=".power.PowerProfileTileService"
            android:exported="true"
            android:label="@string/power_profile_title"
            android:icon="@drawable/ic_power_profile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".fan.FanTileService"
            android:exported="true"
            android:label="@string/fan_control_title"
            android:icon="@drawable/ic_fan"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".trigger.TriggerTileService"
            android:exported="true"
            android:label="@string/trigger_buttons_title"
            android:icon="@drawable/ic_triggers"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".power.ChargeBypassTileService"
            android:exported="true"
            android:label="@string/charge_bypass_tile_label"
            android:icon="@drawable/ic_charge_bypass"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <!-- Gaming HUD Live Overlay & QS Tile -->
        <service
            android:name=".hud.GamingHudOverlayService"
            android:exported="false" />

        <service
            android:name=".hud.GamingHudTileService"
            android:exported="true"
            android:label="Gaming HUD"
            android:icon="@drawable/ic_power_profile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <!-- Home Screen Gaming HUD Widget -->
        <receiver
            android:name=".widget.GamingHudWidget"
            android:label="@string/widget_gaming_hud_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="org.lineageos.settings.widget.REFRESH_HUD" />
                <action android:name="org.lineageos.settings.widget.TOGGLE_DIABLO" />
                <action android:name="org.lineageos.settings.widget.TOGGLE_FAN" />
                <action android:name="org.lineageos.settings.widget.TOGGLE_TRIGGERS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_gaming_hud_info" />
        </receiver>
    </application>
</manifest>
