# Fan & RGB sysfs
rw_dir_file(system_app, sysfs_fan)
rw_dir_file(system_app, sysfs_aw22xxx)

# Touchscreen & Shoulder Triggers
rw_dir_file(system_app, vendor_sysfs_touchpanel)

# Trigger buttons
rw_dir_file(system_app, proc_touchkey)

# Sched WALT controls
rw_dir_file(system_app, proc_walt)

# Battery supply (temps, charge bypass, limits)
rw_dir_file(system_app, vendor_sysfs_battery_supply)

# Thermal & CPU & GPU & Graphics
allow system_app sysfs_thermal:file rw_file_perms;
allow system_app sysfs_thermal:dir r_dir_perms;
allow system_app sysfs_devices_system_cpu:file rw_file_perms;
allow system_app sysfs_devices_system_cpu:dir r_dir_perms;
allow system_app vendor_sysfs_kgsl:file rw_file_perms;
allow system_app vendor_sysfs_kgsl:dir r_dir_perms;
allow system_app vendor_sysfs_graphics:file rw_file_perms;
allow system_app vendor_sysfs_graphics:dir r_dir_perms;

# Cgroup & UCLAMP
allow system_app cgroup:file rw_file_perms;
allow system_app cgroup:dir r_dir_perms;
allow system_app cgroup_v2:file rw_file_perms;
allow system_app cgroup_v2:dir r_dir_perms;

# Properties
get_prop(system_app, vendor_zte_prop)
