on post-fs
    chown system system /sys/devices/platform/goodix_ts.0/gesture/single_en
    chown system system /sys/devices/platform/goodix_ts.0/gesture/single_pressed
    chown system system /sys/devices/platform/goodix_ts.0/gesture/double_en
    chown system system /sys/devices/platform/goodix_ts.0/gesture/double_pressed
    chown system system /sys/devices/platform/goodix_ts.0/gesture/fod_en
    chown system system /sys/devices/platform/goodix_ts.0/gesture/fod_pressed
    chown system system /sys/devices/platform/goodix_ts.0/rotation
