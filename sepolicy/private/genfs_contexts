# Fan control
genfscon sysfs /kernel/fan                         u:object_r:sysfs_fan:s0

# Trigger buttons
genfscon proc /nubia_key                           u:object_r:proc_touchkey:s0

# Goodix Touchscreen & Triggers
genfscon sysfs /devices/platform/goodix_ts.0       u:object_r:sysfs_touch:s0
genfscon sysfs /devices/platform/goodix_ts.1       u:object_r:sysfs_touch:s0

# KGSL GPU sysfs
genfscon sysfs /class/kgsl                         u:object_r:sysfs_kgsl:s0

